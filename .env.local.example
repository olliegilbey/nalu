# Dev values only. Production values live in Vercel (docs/DEPLOY.md). The
# gitignored .env.production.local holds production's DATABASE_URL,
# DIRECT_URL and POSTHOG_PERSONAL_API_KEY, for `just db-migrate-prod` and
# the read-only inspectors in .claude/skills/.

# Supabase (new key system — sb_publishable_/sb_secret_, not legacy JWTs).
# Local work uses `just dev`: it signs in through the x-dev-user-id stub
# (src/server/requestUser.ts) and never calls Supabase, so placeholders do.
# `just start` is different: `next start` sets NODE_ENV=production, so
# src/proxy.ts and requestUser.ts call Supabase. It needs real keys, and it
# creates anonymous users in that Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=your-cerebras-api-key
# gpt-oss-120b is the default model. Honours strict-mode
# JSON schema constrained decoding (response_format: {type: "json_schema",
# strict: true}). Slight prompt-budget overhead from being a reasoning model
# — ~40 reasoning tokens per turn.
LLM_MODEL=gpt-oss-120b

# Free-text grading diagnosis (GitHub issue #22). Set to 1 to emit per-grading
# `[grading-debug]` lines to stderr at the scoping/wave close paths — question
# id, grading kind beside the learner's response kind, verdict, quality score,
# computed XP, and a truncated response excerpt — plus strip-path and
# parse-failure lines. DEV/SMOKE ONLY: these lines contain learner answers and
# raw LLM output. The code honours the flag only under NODE_ENV development or
# test, so Vercel (NODE_ENV=production) never logs them. Absent or any value
# other than 1 = a true no-op (no content logged, no extra DB reads).
LLM_DEBUG_GRADINGS=0

# Postgres: the dev container that `just db-up` starts. It uses trust auth,
# so the URL has no password. No `?pgbouncer=true` here: plain Postgres
# rejects it as an unknown parameter. Production's pooled DATABASE_URL keeps
# it. `just db-migrate`, `db-seed` and `db-reset` refuse any other host.
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres@127.0.0.1:54322/postgres
# Dev user UUID — seed.ts inserts it; outside production it is the signed-in user
DEV_USER_ID=a0000000-0000-4000-8000-000000000001
# Dev-only — the seeded user the tRPC client claims to be.
# Must match DEV_USER_ID above (Next.js requires NEXT_PUBLIC_ prefix to expose to client).
NEXT_PUBLIC_DEV_USER_ID=a0000000-0000-4000-8000-000000000001

# PostHog analytics (server-side, anonymous). proxy.ts captures one $pageview
# per visit with the real client IP as $ip (correct GeoIP). Reuses resumate's
# EU project — paste that project's public key. Absent = analytics disabled.
# Only used in production (proxy.ts is prod-gated). Events carry app:"nalu".
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
