exports[`schemas carrying an MC option key keep their bytes > learner responses schema 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "description": "[server] Matches the question's id."
          },
          "choice": {
            "description": "[UI→server] MC option key selected by the learner. Set only when the learner clicks an MC option.",
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "freetext": {
            "description": "[UI→server] Free-text body. Set for free-text questions or when the learner uses the freetext-escape on an MC question.",
            "type": "string"
          }
        },
        "required": [
          "questionId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "responses"
  ],
  "additionalProperties": false
}"
`;

exports[`schemas carrying an MC option key keep their bytes > presentQuestionnaire tool input 1`] = `
"{
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable identifier, unique within this questionnaire (e.g. 'q1')."
          },
          "type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "free_text"
            ],
            "description": "Question kind."
          },
          "prompt": {
            "type": "string",
            "description": "The question shown to the learner."
          },
          "conceptName": {
            "description": "Concept this question assesses - an existing concept name or a new one. Required for every question.",
            "type": "string"
          },
          "freetextRubric": {
            "type": "string",
            "description": "How to grade the answer if the learner replies in free text: what a correct answer must contain, naming the key idea the grader checks the learner's text for, in at least 20 characters. Never shown to the learner."
          },
          "options": {
            "description": "Four keyed options shown to the learner. Required for multiple_choice; omit for free_text.",
            "type": "object",
            "properties": {
              "A": {
                "type": "string"
              },
              "B": {
                "type": "string"
              },
              "C": {
                "type": "string"
              },
              "D": {
                "type": "string"
              }
            },
            "required": [
              "A",
              "B",
              "C",
              "D"
            ],
            "additionalProperties": false
          },
          "correct": {
            "description": "Correct option key. Never shown to the learner. Required for multiple_choice; omit for free_text.",
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "tier": {
            "description": "Framework tier this question targets.",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "type",
          "prompt",
          "freetextRubric"
        ],
        "additionalProperties": false
      },
      "description": "1-3 questions. Every question's id must be unique within this questionnaire."
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}"
`;

exports[`schemas carrying an MC option key keep their bytes > wave turn route input 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "courseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "waveNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "chat-text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "questionnaire-answers"
            },
            "questionnaireId": {
              "type": "string",
              "minLength": 1
            },
            "answers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "const": "mc"
                      },
                      "selected": {
                        "type": "string",
                        "enum": [
                          "A",
                          "B",
                          "C",
                          "D"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "selected"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "const": "freetext"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fromEscape": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "text",
                      "fromEscape"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "kind",
            "questionnaireId",
            "answers"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "courseId",
    "waveNumber",
    "payload"
  ],
  "additionalProperties": false
}"
`;

