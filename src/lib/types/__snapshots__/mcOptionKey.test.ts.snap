exports[`schemas carrying an MC option key keep their bytes > baseline response_format 1`] = `
"{
  "type": "json",
  "name": "baseline",
  "schema": {
    "type": "object",
    "properties": {
      "userMessage": {
        "type": "string",
        "description": "[chat] Warm chat-bubble framing the baseline. Do NOT enumerate the questions; the UI renders cards."
      },
      "questions": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "[server] Stable identifier so responses can be matched back to questions."
                    },
                    "type": {
                      "type": "string",
                      "const": "free_text",
                      "description": "[server] Question kind discriminator."
                    },
                    "prompt": {
                      "type": "string",
                      "description": "[UI] The question shown to the learner."
                    },
                    "freetextRubric": {
                      "type": "string",
                      "description": "[server] How to grade a free-text response. Never shown to the learner."
                    },
                    "conceptName": {
                      "description": "[server] Concept this question probes. Required for baseline + teaching quizzes.",
                      "type": "string"
                    },
                    "tier": {
                      "description": "[server] Framework tier this question targets. Required for baseline + teaching quizzes.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "prompt",
                    "freetextRubric"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "[server] Stable identifier."
                    },
                    "type": {
                      "type": "string",
                      "const": "multiple_choice",
                      "description": "[server] Question kind discriminator."
                    },
                    "prompt": {
                      "type": "string",
                      "description": "[UI] The question shown to the learner."
                    },
                    "options": {
                      "type": "object",
                      "properties": {
                        "A": {
                          "type": "string"
                        },
                        "B": {
                          "type": "string"
                        },
                        "C": {
                          "type": "string"
                        },
                        "D": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ],
                      "additionalProperties": false,
                      "description": "[UI] Four keyed options shown to the learner. Learner can also bypass via the free-text escape rendered alongside the buttons."
                    },
                    "correct": {
                      "description": "[server] Correct option key. NEVER shown to the learner. PRESENT for graded questions (baseline, quiz) so the client can score MC immediately without a round-trip; ABSENT for elicitation (clarify) where there is no right answer.",
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "freetextRubric": {
                      "type": "string",
                      "description": "[server] How to grade if the learner uses the free-text escape. Never shown."
                    },
                    "conceptName": {
                      "description": "[server] Concept probed.",
                      "type": "string"
                    },
                    "tier": {
                      "description": "[server] Framework tier targeted.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "prompt",
                    "options",
                    "freetextRubric"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "[UI] Exactly 9 questions: 3 per tier, for tiers [1, 2, 3] only. Every question is STANDALONE — never reference another question. Mix multiple_choice and free_text. MC: 4 keyed options A/B/C/D, no 'Not sure' option. Every question carries \`conceptName\`, \`tier\`, and \`freetextRubric\`. Every MC carries \`correct\`. Every question is graded: each free_text \`freetextRubric\` states what a correct answer must contain, naming the key idea the grader checks the learner's text for, in at least 20 characters. Use ids b1, b2, b3, … in order."
          }
        },
        "required": [
          "questions"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "userMessage",
      "questions"
    ],
    "additionalProperties": false
  }
}"
`;

exports[`schemas carrying an MC option key keep their bytes > clarify response_format 1`] = `
"{
  "type": "json",
  "name": "clarify",
  "schema": {
    "type": "object",
    "properties": {
      "userMessage": {
        "type": "string",
        "description": "[chat] Warm, brief chat-bubble shown verbatim to the learner. Frame what you're about to ask and why — do NOT enumerate the questions here; the UI renders the question cards from the \`questions\` field."
      },
      "questions": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "[server] Stable identifier so responses can be matched back to questions."
                    },
                    "type": {
                      "type": "string",
                      "const": "free_text",
                      "description": "[server] Question kind discriminator."
                    },
                    "prompt": {
                      "type": "string",
                      "description": "[UI] The question shown to the learner."
                    },
                    "freetextRubric": {
                      "type": "string",
                      "description": "[server] How to grade a free-text response. Never shown to the learner."
                    },
                    "conceptName": {
                      "description": "[server] Concept this question probes. Required for baseline + teaching quizzes.",
                      "type": "string"
                    },
                    "tier": {
                      "description": "[server] Framework tier this question targets. Required for baseline + teaching quizzes.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "prompt",
                    "freetextRubric"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "[server] Stable identifier."
                    },
                    "type": {
                      "type": "string",
                      "const": "multiple_choice",
                      "description": "[server] Question kind discriminator."
                    },
                    "prompt": {
                      "type": "string",
                      "description": "[UI] The question shown to the learner."
                    },
                    "options": {
                      "type": "object",
                      "properties": {
                        "A": {
                          "type": "string"
                        },
                        "B": {
                          "type": "string"
                        },
                        "C": {
                          "type": "string"
                        },
                        "D": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ],
                      "additionalProperties": false,
                      "description": "[UI] Four keyed options shown to the learner. Learner can also bypass via the free-text escape rendered alongside the buttons."
                    },
                    "correct": {
                      "description": "[server] Correct option key. NEVER shown to the learner. PRESENT for graded questions (baseline, quiz) so the client can score MC immediately without a round-trip; ABSENT for elicitation (clarify) where there is no right answer.",
                      "type": "string",
                      "enum": [
                        "A",
                        "B",
                        "C",
                        "D"
                      ]
                    },
                    "freetextRubric": {
                      "type": "string",
                      "description": "[server] How to grade if the learner uses the free-text escape. Never shown."
                    },
                    "conceptName": {
                      "description": "[server] Concept probed.",
                      "type": "string"
                    },
                    "tier": {
                      "description": "[server] Framework tier targeted.",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "prompt",
                    "options",
                    "freetextRubric"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "One or more questions. UI shows them one at a time; the learner submits the whole questionnaire before the model sees responses. Clarify: 2–4 questions; baseline: count determined by scope tiers. Every question's \`id\` must be unique within this questionnaire."
          }
        },
        "required": [
          "questions"
        ],
        "additionalProperties": false,
        "description": "[UI] Between 2 and 4 clarifying questions. Questions are elicitation — no \`conceptName\`, no \`tier\`, no \`correct\`. Nothing here is graded: set every \`freetextRubric\` to 'no grading — informational'. Focus on scope, baseline knowledge, and end goal."
      }
    },
    "required": [
      "userMessage",
      "questions"
    ],
    "additionalProperties": false
  }
}"
`;

exports[`schemas carrying an MC option key keep their bytes > course.submitBaseline tRPC input 1`] = `
"{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "courseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "answers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "mc"
              },
              "selected": {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "selected"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "const": "freetext"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "fromEscape": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "text",
              "fromEscape"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "courseId",
    "answers"
  ],
  "additionalProperties": false
}"
`;

